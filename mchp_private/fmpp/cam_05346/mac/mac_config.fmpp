# sourceRoot and outputRoot are handled as parameters within generateFiles.py (CryptoV4 repository path)
removeExtensions: ftl

sources: [
    
    # Common Crypto Source Files
    common_crypto/src/crypto_hash.c.ftl,
    common_crypto/src/crypto_mac_cipher.c.ftl,
    common_crypto/src/crypto_aead_cipher.c.ftl,

    # Common Crypto Header Files
    common_crypto/crypto_hash.h.ftl,
    common_crypto/crypto_mac_cipher.h.ftl,
    common_crypto/crypto_aead_cipher.h.ftl,
    common_crypto/crypto_common.h.ftl,

    # CAM Wrapper Source Files
    cam_05346/wrapper/src/crypto_hash_cam05346_wrapper.c.ftl,
    cam_05346/wrapper/src/crypto_mac_cam05346_wrapper.c.ftl,
    cam_05346/wrapper/src/crypto_aead_cam05346_wrapper.c.ftl,
    cam_05346/wrapper/src/crypto_cam05346_wrapper.c.ftl,

    # CAM Wrapper Header Files
    cam_05346/wrapper/crypto_hash_cam05346_wrapper.h.ftl,
    cam_05346/wrapper/crypto_mac_cam05346_wrapper.h.ftl,
    cam_05346/wrapper/crypto_aead_cam05346_wrapper.h.ftl,
    cam_05346/wrapper/crypto_cam05346_wrapper.h.ftl
]

data: {
    core: {
        COMPILER_CHOICE: "dsPIC33",
        COVERITY_SUPPRESS_DEVIATION: false
    },
    driver_defines: "HAVE_CRYPTO_HW_CAM_05346_DRIVER",
    crypto_digisign_cam05346_wrapper_h_ftl_flag: true,
    crypto_hash_cam05346_wrapper_h_ftl_flag: true,
    crypto_aead_cam05346_wrapper_h_ftl_flag: true,
    crypto_mac_cam05346_wrapper_h_ftl_flag: true,
    CRYPTO_HW_SHA1: true,
    CRYPTO_HW_SHA2_224: true,
    CRYPTO_HW_SHA2_256: true,
    CRYPTO_HW_SHA2_384: true,
    CRYPTO_HW_SHA2_512: true,
    CRYPTO_HW_AES_ECB: true,
    CRYPTO_HW_AES_CTR: true,
    CRYPTO_HW_AES_CBC: true,
    CRYPTO_HW_AES_CFB128: true,
    CRYPTO_HW_AES_OFB: true,
    CRYPTO_HW_AES_GCM: true,
    CRYPTO_HW_AES_CCM: true,
    CRYPTO_HW_AES_XTS: true,
    CRYPTO_HW_AES_CMAC: true,
    CRYPTO_HW_AES_GMAC: true,
    CRYPTO_HW_HMAC: true
}