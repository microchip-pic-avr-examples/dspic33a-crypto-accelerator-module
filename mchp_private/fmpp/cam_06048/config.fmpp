sourceRoot: .
outputRoot: ../output
removeExtensions: ftl

data: {
    crypto_hash_cam06048_wrapper_h_ftl_flag: true,
	CRYPTO_HW_RNG_TRNG: true,
    driver_defines: "HAVE_CRYPTO_HW_CAM_06048_DRIVER, \
		HAVE_CRYPTO_HW_TRNG_06048_DRIVER, \
        CRYPTO_HASH_SESSION_MAX (1), \
        CRYPTO_HASH_HW_ALGO_EN, \
        CRYPTO_HASH_SHA1_EN, \
        CRYPTO_HASH_SHA2_EN, \
        CRYPTO_HASH_SHA2_224_EN, \
        CRYPTO_HASH_HW_SHA2_224_EN, \
        CRYPTO_HASH_SHA2_256_EN, \
        CRYPTO_HASH_HW_SHA2_256_EN, \
        CRYPTO_HASH_SHA2_384_EN, \
        CRYPTO_HASH_HW_SHA2_384_EN, \
        CRYPTO_HASH_SHA2_512_EN, \
        CRYPTO_HASH_HW_SHA2_512_EN, \
        CRYPTO_HASH_HW_SHA2_EN,
        CRYPTO_HASH_HW_SHA3_224_EN, \
        CRYPTO_HASH_HW_SHA3_EN,
        CRYPTO_HASH_HW_SHA3_256_EN, \
        CRYPTO_HASH_HW_SHA3_EN,
        CRYPTO_HASH_HW_SHA3_384_EN, \
        CRYPTO_HASH_HW_SHA3_EN,
        CRYPTO_HASH_HW_SHA3_512_EN, \
        CRYPTO_HASH_HW_SHA3_EN",
    CRYPTO_HW_ECDSA: true,
    core: {
        COMPILER_CHOICE: "dsPIC33",
        COVERITY_SUPPRESS_DEVIATION: false
    },
    CRYPTO_HW_SHA1: true,
    CRYPTO_HW_SHA2_224: true,
    CRYPTO_HW_SHA2_256: true,
    CRYPTO_HW_SHA2_384: true,
    CRYPTO_HW_SHA2_512: true,
    CRYPTO_HW_SHA3_224: true,
    CRYPTO_HW_SHA3_256: true,
    CRYPTO_HW_SHA3_384: true,
    CRYPTO_HW_SHA3_512: true,
    CRYPTO_HW_AES_ECB: true,
    CRYPTO_HW_AES_CTR: true,
    CRYPTO_HW_AES_CBC: true,
    CRYPTO_HW_AES_CFB128: true,
    CRYPTO_HW_AES_OFB: true,
    CRYPTO_HW_AES_GCM: true,
    CRYPTO_HW_AES_CCM: true,
    CRYPTO_HW_AES_XTS: true
    CRYPTO_HW_AES_CMAC: true,
    CRYPTO_HW_AES_GMAC: true,
    CRYPTO_HW_HMAC: true,
    CRYPTO_HW_ECDH: true,
}