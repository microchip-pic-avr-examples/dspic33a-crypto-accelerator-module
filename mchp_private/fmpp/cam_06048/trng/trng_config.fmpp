# sourceRoot and outputRoot are handled as parameters within generateFiles.py (CryptoV4 repository path)
removeExtensions: ftl

sources: [
    
    # Common Crypto Source Files
    common_crypto/src/crypto_rng.c.ftl,

    # Common Crypto Header Files
    common_crypto/crypto_rng.h.ftl,
    common_crypto/crypto_common.h.ftl,

    # CAM Wrapper Source Files
    cam_06048/wrapper/src/crypto_rng_cam06048_wrapper.c.ftl,
    cam_06048/wrapper/src/crypto_cam06048_wrapper.c.ftl,

    # CAM Wrapper Header Files
    cam_06048/wrapper/crypto_rng_cam06048_wrapper.h.ftl,
    cam_06048/wrapper/crypto_cam06048_wrapper.h.ftl
]

data: {
    core: {
        COMPILER_CHOICE: "dsPIC33",
        COVERITY_SUPPRESS_DEVIATION: false
    },
    driver_defines: "HAVE_CRYPTO_HW_CAM_06048_DRIVER, \
        HAVE_CRYPTO_HW_TRNG_06048_DRIVER",
    crypto_rng_cam06048_wrapper_h_ftl_flag: true,
	CRYPTO_HW_RNG_TRNG: true
}